# Fraud Shield AI - Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB
FRAUD_SHIELD_MONGO_URI=mongodb://localhost:27017
FRAUD_SHIELD_MONGO_DB_NAME=fraud_shield_ai

# LLM Provider (gemini or openai)
FRAUD_SHIELD_LLM_PROVIDER=gemini
FRAUD_SHIELD_GEMINI_API_KEY=
FRAUD_SHIELD_OPENAI_API_KEY=

# Server
FRAUD_SHIELD_LOG_LEVEL=INFO
FRAUD_SHIELD_CORS_ORIGINS=["*"]
